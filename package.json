{
  "name": "mortar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm run dev -w @mortar/server\" \"npm run dev -w @mortar/client\"",
    "build": "npm run build -w @mortar/client && npm run build -w @mortar/server",
    "start": "npm run start -w @mortar/server",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "typescript": "~5.9.0",
    "vitest": "^4.1.10"
  }
}
